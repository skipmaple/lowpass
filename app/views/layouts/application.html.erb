<!DOCTYPE html>
<html lang="zh-CN" data-theme="daybreak">
  <head>
    <title data-inertia><%= content_for(:title) || "Lowpass" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Lowpass">
    <meta name="mobile-web-app-capable" content="yes">
    <%# 设计说明 2026-10-14 D1：简介用附录 B 的登录页一句话；手机浏览器顶栏跟报头墨带同色；分享卡片落在登录页上也成立 %>
    <meta name="description" content="每天一期技术日刊，登录后阅读">
    <meta name="theme-color" content="#FCFAF2">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta property="og:site_name" content="Lowpass">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Lowpass">
    <meta property="og:description" content="每天一期技术日刊，登录后阅读">
    <meta property="og:image" content="<%= request.base_url %>/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= inertia_ssr_head %>

    <link rel="icon" href="/icon.png?v=3" type="image/png">
    <link rel="icon" href="/icon.svg?v=3" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png?v=3">

    <%# Apply the saved theme before styles paint. Storage may be blocked. %>
    <%= javascript_tag nonce: true do %>
      var theme = 'daybreak';
      try {
        var savedTheme = localStorage.getItem('lowpass-theme');
        if (['daybreak', 'duet', 'unfold'].includes(savedTheme)) theme = savedTheme;
      } catch (_) {}
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').content = {daybreak:'#FCFAF2',duet:'#FCFCFA',unfold:'#111515'}[theme];
      var themeFonts = <%= raw json_escape(theme_font_preloads.to_json) %>;
      themeFonts[theme].forEach(function(url) {
        var font = document.createElement('link');
        font.rel = 'preload'; font.as = 'font'; font.type = 'font/woff2'; font.crossOrigin = ''; font.href = url;
        document.head.appendChild(font);
      });
    <% end %>

    <%= search_page_preload_tag %>

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_stylesheet_tag "application" %>
    <%= render "shared/startup_guard" %>
    <%= vite_typescript_tag "application.tsx", data: { startup_entry: true } %>
  </head>

  <body>
    <%= yield %>
    <%= render "shared/startup_recovery", hidden: true %>
    <noscript><%= render "shared/startup_recovery", hidden: false %></noscript>
  </body>
</html>
