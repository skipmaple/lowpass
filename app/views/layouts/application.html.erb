<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <title data-inertia><%= content_for(:title) || "Lowpass" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Lowpass">
    <meta name="mobile-web-app-capable" content="yes">
    <%# 设计说明 2026-10-14 D1：简介用附录 B 的登录页一句话；手机浏览器顶栏跟报头墨带同色；分享卡片落在登录页上也成立 %>
    <meta name="description" content="每天一期技术日刊，登录后阅读">
    <meta name="theme-color" content="#1D1D1B">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta property="og:site_name" content="Lowpass">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Lowpass">
    <meta property="og:description" content="每天一期技术日刊，登录后阅读">
    <meta property="og:image" content="<%= request.base_url %>/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= inertia_ssr_head %>

    <link rel="icon" href="/icon.png?v=3" type="image/png">
    <link rel="icon" href="/icon.svg?v=3" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png?v=3">

    <%# 每页都有的界面字（报头、期头、页脚）在这个文楷子集里：不等 JS 渲染出文字才发现要它（script/subset_fonts） %>
    <link rel="preload" href="<%= vite_asset_path "fonts/lxgw-wenkai-screen-ui.woff2" %>" as="font" type="font/woff2" crossorigin>
    <%= latin_font_preload_tag %>
    <%# 正文字体声明不挡首屏：先 preload，lib/contentFonts.ts 启动时挂成样式表（设计说明 2026-10-14 D3） %>
    <link rel="preload" as="style" href="<%= vite_asset_path "fonts-content.css" %>" data-content-fonts>

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_stylesheet_tag "application" %>
    <%= render "shared/startup_guard" %>
    <%= vite_typescript_tag "application.tsx", data: { startup_entry: true } %>
  </head>

  <body>
    <%= yield %>
    <%= render "shared/startup_recovery", hidden: true %>
    <noscript><%= render "shared/startup_recovery", hidden: false %></noscript>
  </body>
</html>
