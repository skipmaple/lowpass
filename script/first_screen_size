#!/usr/bin/env ruby
# Budget each persisted theme separately. Count entry + daily JS, shared CSS,
# the immediately requested content font-face stylesheet, and all shell fonts.
# Content glyph shards depend on the edition; report their network cost in the
# browser acceptance record, as before (PRD N-1), rather than treating it as zero.
require "json"
require "zlib"

BUILD = File.expand_path("../public/vite", __dir__)
BUDGET_KB = 300
ENTRIES = %w[entrypoints/application.tsx pages/Daily/Show.tsx].freeze
THEMES = {
  "A 层叠清晨" => [ "daybreak", "a", %w[body display] ],
  "B 双声部" => [ "duet", "b", %w[body display] ],
  "C 展开阅读" => [ "unfold", "c", %w[body title date] ]
}.freeze

manifest = JSON.parse(File.read(File.join(BUILD, ".vite/manifest.json")))
collect = lambda do |key, found|
  chunk = manifest.fetch(key)
  unless found.include?(chunk.fetch("file"))
    found << chunk.fetch("file")
    chunk.fetch("imports", []).each { |dependency| collect.call(dependency, found) }
  end
  found
end
gzip_size = ->(name) { Zlib.gzip(File.binread(File.join(BUILD, name)), level: Zlib::BEST_COMPRESSION).bytesize }
raw_size = ->(key) { File.size(File.join(BUILD, manifest.fetch(key).fetch("file"))) }
scripts = ENTRIES.each_with_object([]) { |entry, files| collect.call(entry, files) }
shared = scripts.sum { |file| gzip_size.call(file) } + gzip_size.call(manifest.fetch("entrypoints/application.css").fetch("file"))
passed = true
THEMES.each do |label, (name, prefix, latin_roles)|
  content_css = gzip_size.call(manifest.fetch("styles/fonts-#{name}-content.css").fetch("file"))
  fonts = %w[regular bold].sum { |weight| raw_size.call("fonts/themes/#{prefix}-#{weight}-ui.woff2") }
  fonts += latin_roles.sum { |role| raw_size.call("fonts/themes/#{prefix}-latin-#{role}.woff2") }
  total = (shared + content_css + fonts) / 1024.0
  puts format("%s: JS/CSS %.2f + content declarations %.2f + shell fonts %.2f = %.2f KiB (budget %d)", label, shared / 1024.0, content_css / 1024.0, fonts / 1024.0, total, BUDGET_KB)
  passed &&= total <= BUDGET_KB
end
exit(passed ? 0 : 1)
